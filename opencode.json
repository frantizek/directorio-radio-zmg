{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}